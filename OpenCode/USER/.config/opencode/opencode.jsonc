{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "lsp": {},
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max",
      "textVerbosity": "low"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max",
      "textVerbosity": "low"
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "reasoningEffort": "max",
      "textVerbosity": "low"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp.exe"
      ],
      "enabled": true
    }
  }
}