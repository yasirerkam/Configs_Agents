{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "lsp": {},
  "agent": {
    "build": {
      "mode": "primary",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "options": {
        "reasoningEffort": "max",
        "textVerbosity": "low"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "options": {
        "reasoningEffort": "max",
        "textVerbosity": "low"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "options": {
        "reasoningEffort": "max",
        "textVerbosity": "low"
      }
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp.exe"
      ],
      "enabled": true
    }
  }
}