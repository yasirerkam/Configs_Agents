{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "provider": {
    "OpenWebUI-yeo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Web UI - yeo",
      "options": {
        "baseURL": "https://gpt.ehsim.net/api/v1"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2-owu",
          "thinking": true,
          "reasoningEffort": "max",
          "textVerbosity": "low",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          }
          // "limit": {
          //   "context": 262144,
          //   "output": 32000
          // }
        }
      }
    },
    "LiteLLM-ada-yeo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM-ada-yeo",
      "options": {
        "baseURL": "https://10.0.0.188:4000/v1",
        "apiKey": "sk-asdfasdf"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2-lite",
          "thinking": true,
          "reasoningEffort": "max",
          "textVerbosity": "low",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          }
          // "limit": {
          //   "context": 262144,
          //   "output": 32000
          // }
        }
      }
    },
    "LiteLLM-dgx-yeo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM-dgx-yeo",
      "options": {
        "baseURL": "http://10.91.0.145:4000/v1",
        "apiKey": "sk-Zpl9ae8EnfZ0Dp3c8kUQwA"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "qwen3.8-27b",
          "thinking": true,
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": true
            }
          },
            "modalities": {
              "input": [
                "text",
                "image"
              ],
              "output": [
                "text"
              ]
            }
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "OpenWebUI-yeo/glm-5.2"
    },
    "plan": {
      "mode": "primary",
      "model": "OpenWebUI-yeo/glm-5.2"
    },
    "explore": {
      "mode": "subagent",
      "model": "OpenWebUI-yeo/glm-5.2"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp.exe"
      ],
      "enabled": false
    }
  }
}