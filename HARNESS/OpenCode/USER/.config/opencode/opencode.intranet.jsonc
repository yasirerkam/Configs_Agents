{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "provider": {
    "OpenWebUI": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Web UI",
      "options": {
        "baseURL": "https://gpt.ehsim.net/api/v1"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2-nvfp4",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    },
    "LiteLLM-glm-5.2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM-glm-5.2",
      "options": {
        "baseURL": "https://10.0.0.188:4000/v1"
      },
      "models": {
        "glm-5.2": {
          "name": "glm-5.2",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "limit": {
        "context": 262144,
        "output": 32000
      }
    },
    "plan": {
      "mode": "primary",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "limit": {
        "context": 262144,
        "output": 32000
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "LiteLLM-glm-5.2/glm-5.2",
      "reasoningEffort": "max",
      "textVerbosity": "low",
      "limit": {
        "context": 262144,
        "output": 32000
      }
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ],
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp.exe"
      ],
      "enabled": true
    }
  }
}